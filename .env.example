# Copy to server/.env (and web/.env for the two VITE_-prefixed values) and fill in real values.
# See server/.env.example and web/.env.example for the split, workspace-scoped versions of this file.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,write_products,read_product_listings

FAL_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WAVESPEED_API_KEY=

FIREBASE_SERVICE_ACCOUNT_JSON=

# Mandatory "Sign in with Google" gate — see server/.env.example for setup notes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
SENTRY_DSN=

# Long random secret gating the platform-admin template-management tool (admin/ workspace).
ADMIN_API_KEY=

PORT=3000
NODE_ENV=development
