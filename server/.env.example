SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products,write_products,read_product_listings

FAL_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WAVESPEED_API_KEY=

# Path to a service account JSON file, OR the JSON contents themselves (both supported).
FIREBASE_SERVICE_ACCOUNT_JSON=

# From your Cloudinary dashboard's API Keys page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
SENTRY_DSN=

# Long random secret gating the platform-admin template-management tool (admin/ workspace) —
# not a merchant-facing credential. Generate with e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=

PORT=3000
NODE_ENV=development
